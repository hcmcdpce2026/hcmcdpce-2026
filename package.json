{
  "name": "hcmc-drug-prevention-portal",
  "version": "1.1.0",
  "private": true,
  "description": "Chuyên trang điện tử về phòng, chống ma túy tại Thành phố Hồ Chí Minh – PUBLIC, CMS và WORKSPACE trên một nền tảng dữ liệu thống nhất.",
  "keywords": [
    "phong-chong-ma-tuy",
    "ho-chi-minh-city",
    "portal",
    "cms",
    "workspace",
    "nodejs",
    "sqlite"
  ],
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:reset": "node server/db/seed.js --reset",
    "db:backup": "node server/scripts/backup-database.js",
    "db:restore": "node server/scripts/restore-database.js",
    "content:reset": "node server/scripts/reset-content.js",
    "test": "node server/scripts/test-api.js",
    "test:isolated": "node server/scripts/run-tests-isolated.js",
    "test:interconnect": "node server/scripts/smoke-interconnect.js",
    "test:security": "node server/scripts/smoke-security.js",
    "test:workspace": "node server/scripts/smoke-workspace-crud.js",
    "test:clean": "node server/scripts/clean-test-data.js",
    "test:content-types": "node server/scripts/run-content-type-tests.js",
    "test:article-tags": "node server/scripts/test-article-tags.js",
    "demo:purge": "node server/db/content-types.js --purge",
    "export:static-public": "node server/scripts/export-static-public.js && node server/scripts/check-static-public.js",
    "prepare:github-pages": "node server/scripts/prepare-github-pages.js",
    "check:static-public": "node server/scripts/check-static-public.js",
    "check:static-public:git": "node server/scripts/check-static-public.js --check-git",
    "check": "node scripts/check-encoding.js && node scripts/security-scan.js",
    "data": "node server/scripts/data-tool.js"
  },
  "dependencies": {
    "mammoth": "^1.13.0"
  }
}
