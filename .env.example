# =============================================================================
# CHUYÊN TRANG ĐIỆN TỬ VỀ PHÒNG, CHỐNG MA TÚY TẠI THÀNH PHỐ HỒ CHÍ MINH
# Sao chép tệp này thành `.env` rồi điền giá trị thực. KHÔNG commit `.env`.
# =============================================================================

# Môi trường: development | staging | production
APP_ENV=development

# Cổng và địa chỉ lắng nghe
PORT=8099
HOST=0.0.0.0

# Vị trí tệp cơ sở dữ liệu SQLite (tương đối từ thư mục gốc dự án)
DB_FILE=server/data/portal.sqlite

# Phiên đăng nhập (phút) – mặc định 8 giờ
SESSION_TTL_MINUTES=480

# Bảo vệ brute-force: số lần sai tối đa và thời gian khóa (phút)
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Chỉ bật khi chạy sau HTTPS
COOKIE_SECURE=false

# Origin được phép gọi API (để trống nếu frontend cùng origin với backend)
CORS_ORIGIN=

# Mật khẩu bàn giao tài khoản khởi tạo.
# Nếu để trống, hệ thống sẽ sinh mật khẩu ngẫu nhiên và ghi vào
# server/data/credentials.local.txt (không nằm trong git).
SEED_PASSWORD_CMS_ADMIN=
SEED_PASSWORD_CMS_NGUYENPHUONGUYEN=
SEED_PASSWORD_CMS_NGUYENHOANGMYTAM=
SEED_PASSWORD_CMS_PHAMMINHNGUYEN=
SEED_PASSWORD_CMS_LOHUYENTHUONG=
SEED_PASSWORD_WS_ADMIN=
SEED_PASSWORD_WS_NGUYENPHUONGUYEN=
SEED_PASSWORD_WS_NGUYENHOANGMYTAM=
SEED_PASSWORD_WS_PHAMMINHNGUYEN=
SEED_PASSWORD_WS_LOHUYENTHUONG=

# CHỈ dùng trong kiểm thử tự động: bỏ giới hạn tần suất
RATE_LIMIT_DISABLED=false
